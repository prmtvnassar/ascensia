# Normalise line endings for everyone, whatever their OS or core.autocrlf.
# Without this, each contributor's Git rewrites line endings on checkout and
# commit according to their own local setting, so untouched files show up as
# fully rewritten and every pull turns into a conflict.
#
# Text files are stored as LF in the repository and checked out as LF.
* text=auto eol=lf

# Explicit, so a new extension can't fall through to the wrong behaviour.
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Files Windows tooling expects to have CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binaries: never touch these, never try to diff them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
